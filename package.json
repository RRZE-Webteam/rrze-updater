{
  "name": "rrze-updater",
  "title": "RRZE Updater",
  "version": "2.5.17",
  "description": "Sync Plugins and Themes with the corresponding GitHub or GitLab repositories.",
  "main": "rrze-updater.php",
  "textdomain": "rrze-updater",
  "textDomain": "rrze-updater",
  "private": true,
  "scripts": {
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "dev": "npm run version:dev && npm run build",
    "build": "npm run build:installer && npm run readme",
    "prod": "npm run version:prod && npm run build",
    "release": "npm run version:release && npm run build",
    "build:installer": "node scripts/build-installer.mjs",
    "test:php": "php tests/discovery.php",
    "test:js": "node --test tests/installer-*.test.mjs"
  },
  "compatibility": {
    "wprequires": "6.8",
    "wptestedup": "7.1",
    "phprequires": "8.3"
  },
  "author": {
    "name": "RRZE Webteam",
    "url": "https://github.com/RRZE-Webteam"
  },
  "homepage": "https://github.com/RRZE-Webteam/rrze-updater",
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/rrze-updater.git",
    "issues": "https://github.com/RRZE-Webteam/rrze-updater/issues"
  },
  "license": "GNU General Public License Version 3",
  "licenseurl": "https://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, Updater, GitHub, GitLab, RRZE",
  "dependencies": {
    "@wordpress/api-fetch": "7.19.1",
    "@wordpress/components": "29.5.2",
    "@wordpress/dataviews": "4.15.2",
    "@wordpress/element": "6.19.1",
    "@wordpress/i18n": "5.19.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "overrides": {
    "@babel/runtime": "7.28.4",
    "uuid": "11.1.1"
  }
}
