msgstr "Branch / Updates"

#: src/installer/index.jsx:78
msgid "Planned action / commit"
msgstr "Geplante Aktion / Commit"

#: src/installer/index.jsx:78
msgid "Status"
msgstr "Status"

#: src/installer/index.jsx:78
